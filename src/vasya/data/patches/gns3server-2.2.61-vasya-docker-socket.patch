+class _VasyaHijackedAttach:
+    """VASYA patch: minimal websocket-like wrapper around a hijacked Docker/Podman attach stream (Tty containers)."""
+
+    class _Msg:
+        def __init__(self, type_, data=None):
+            self.type = type_
+            self.data = data
+
+    def __init__(self, reader, writer):
+        self._reader = reader
+        self._writer = writer
+        self.closed = False
+
+    @classmethod
+    async def open(cls, socket_path, path):
+        reader, writer = await asyncio.open_unix_connection(socket_path)
+        writer.write(("POST {} HTTP/1.1\r\nHost: docker\r\nConnection: Upgrade\r\nUpgrade: tcp\r\nContent-Length: 0\r\n\r\n".format(path)).encode())
+        await writer.drain()
+        head = await reader.readuntil(b"\r\n\r\n")
+        status = head.split(b" ", 2)[1] if b" " in head else b""
+        if status not in (b"101", b"200"):
+            writer.close()
+            raise DockerError("Docker attach failed: {}".format(head.decode(errors="replace").splitlines()[0]))
+        return cls(reader, writer)
+
+    async def send_bytes(self, data):
+        if not self.closed:
+            self._writer.write(data)
+            await self._writer.drain()
+
+    async def receive(self):
+        data = await self._reader.read(4096) if not self.closed else b""
+        if not data:
+            self.closed = True
+            return self._Msg(aiohttp.WSMsgType.CLOSE)
+        return self._Msg(aiohttp.WSMsgType.BINARY, data)
+
+    def exception(self):
+        return None
+
+    async def close(self):
+        if not self.closed:
+            self.closed = True
+            self._writer.close()
+
+
 class Docker(BaseManager):
 
